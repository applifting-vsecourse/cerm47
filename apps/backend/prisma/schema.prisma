// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

model Quack {
  id        String     @id @default(cuid())
  // "" on a tombstone
  text      String     @db.Text
  mood      QuackMood?
  // null only on a tombstone; the quack_tombstone_is_empty check ties the two together
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  poll      Poll?
  replies   Reply[]
  // set when the author deleted a quack that already had replies
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@index([userId])
  @@map("quack")
}

model Reply {
  id        String     @id @default(cuid())
  text      String     @db.Text
  mood      QuackMood?
  // RESTRICT: a quack that still has replies can never be hard-deleted
  quack     Quack      @relation(fields: [quackId], references: [id], onDelete: Restrict)
  quackId   String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  // replies of one quack, oldest first
  @@index([quackId, createdAt])
  @@index([userId])
  @@map("reply")
}

model Poll {
  id       String       @id @default(cuid())
  quack    Quack        @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId  String       @unique
  // null = open; set once, never cleared
  closedAt DateTime?
  options  PollOption[]
  votes    PollVote[]

  @@map("poll")
}

model PollOption {
  id       String     @id @default(cuid())
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  text     String     @db.VarChar(80)
  // order the author wrote the options in, 0-based
  position Int
  votes    PollVote[]

  @@unique([pollId, position])
  // target of the composite foreign key on PollVote
  @@unique([id, pollId])
  @@map("poll_option")
}

model PollVote {
  id        String     @id @default(cuid())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  // a vote can only point at an option of its own poll
  option    PollOption @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Cascade)
  optionId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  // one person, one vote
  @@unique([pollId, userId])
  @@index([optionId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?   @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  quacks          Quack[]
  pollVotes       PollVote[]
  replies         Reply[]
  role           UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  bio             String?    @db.VarChar(160)
  defaultMood     QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
